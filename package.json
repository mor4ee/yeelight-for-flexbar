{
  "name": "flexbar-yeelight",
  "version": "0.1.0",
  "repository": "https://github.com/mor4ee/yeelight-for-flexbar",
  "private": true,
  "description": "Local Yeelight light controls for Flexbar",
  "license": "MIT",
  "engines": { "node": ">=22.17" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "build": "tsc -p tsconfig.v1.json && rollup -c",
    "validate": "node scripts/flexcli.mjs plugin validate --path com.mor4ee.yeelight.plugin",
    "prepack": "node scripts/check-default.cjs",
    "pack": "node scripts/flexcli.mjs --port 1 plugin pack --path com.mor4ee.yeelight.plugin"
  },
  "dependencies": { "@eniac/flexdesigner": "1.0.9" },
  "devDependencies": {
    "@eniac/flexcli": "1.0.7",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.0.0",
    "@vue/compiler-sfc": "3.5.40",
    "rollup": "^4.0.2",
    "typescript": "~5.9.0"
  }
}
